+class ActivateCalendarEvent : public AbstractAction {
+  Q_DECLARE_TR_FUNCTIONS(ActivateCalendarEvent)
+
+public:
+  explicit ActivateCalendarEvent(QString id, bool details = false)
+      : AbstractAction(details ? tr("Event details") : tr("Open event"), BuiltinIcon::Calendar),
+        m_id(std::move(id)), m_details(details) {}
+
+  void execute(ApplicationContext *ctx) override {
+    LaunchProps props;
+    props.launchContext = glz::generic::object_t{{"eventId", m_id.toStdString()}};
+    if (m_details) props.launchContext->get_object()["show"] = "details";
+    ctx->navigation->activateEntrypoint(
+        {"@alhimowicz/calendar", m_details ? "upcoming-events" : "next-event"},
+        {.props = std::move(props), .toggleIfAlreadyActive = false});
+  }
+
+private:
+  QString m_id;
+  bool m_details;
+};
+
+} // namespace
+
+void RootCalendarSection::refresh(bool visible) {
+  m_events.clear();
+  if (!visible) return;
+  if (!QFile::exists(
+          QString::fromStdString((Omnicast::dataDir() / "extensions/calendar/package.json").string())))
+    return;
+  QFile file(QString::fromStdString((Omnicast::dataDir() / "support/calendar/agenda.json").string()));
+  if (!file.open(QIODevice::ReadOnly) || file.size() > 12 * 1024 * 1024) return;
+  m_events = upcomingCalendarEvents(file.readAll(), QDateTime::currentMSecsSinceEpoch());
+}
+
+QString RootCalendarSection::itemId(int i) const { return QStringLiteral("calendar:") + m_events.at(i).id; }
+QString RootCalendarSection::itemTitle(int i) const { return m_events.at(i).title; }
+QString RootCalendarSection::itemSubtitle(int i) const {
+  const auto &event = m_events.at(i);
+  const auto start = QDateTime::fromMSecsSinceEpoch(event.start);
+  QString time = QLocale().toString(start.time(), QLocale::ShortFormat);
+  if (start.date() != QDate::currentDate()) time = tr("Tomorrow %1").arg(time);
+  return event.calendar.isEmpty() ? time : tr("%1 · %2").arg(time, event.calendar);
+}
+std::optional<ImageURL> RootCalendarSection::itemIcon(int i) const {
+  const QColor color(m_events.at(i).color);
+  auto icon = ImageURL::builtin(BuiltinIcon::Calendar);
+  return color.isValid() ? icon.setFill(color) : icon.setFill(SemanticColor::Accent);
+}
+QVariant RootCalendarSection::customData(int i, int role) const {
+  if (role != AccessoryText) return {};
+  const auto remaining = m_events.at(i).start - QDateTime::currentMSecsSinceEpoch();
+  return remaining <= 0 ? tr("Now") : tr("in %n min", nullptr, static_cast<int>((remaining + 59999) / 60000));
+}
+QHash<int, QByteArray> RootCalendarSection::customRoleNames() const { return root_search::customRoleNames(); }
+QHash<int, QVariant> RootCalendarSection::customRoleDefaults() const {
+  return root_search::customRoleDefaults();
+}
+std::unique_ptr<ActionPanelState> RootCalendarSection::actionPanel(int i) const {
+  auto panel = std::make_unique<ListActionPanelState>();
+  auto section = panel->createSection();
+  section->addAction(new ActivateCalendarEvent(m_events.at(i).id));
+  section->addAction(new ActivateCalendarEvent(m_events.at(i).id, true));
+  return panel;
+}
