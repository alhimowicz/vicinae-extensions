diff --git a/src/server/tests/calendar-events.cpp b/src/server/tests/calendar-events.cpp
new file mode 100644
index 0000000..276d63c
--- /dev/null
+++ b/src/server/tests/calendar-events.cpp
@@ -0,0 +1,65 @@
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <catch2/catch_test_macros.hpp>
+
+#include "builtins/root/calendar-events.hpp"
+
+namespace {
+constexpr qint64 NOW = 1793178000000;
+
+QJsonObject event(const QString &id, qint64 start, qint64 end, bool allDay = false) {
+  return {{"id", id},
+          {"title", QStringLiteral("Event %1").arg(id)},
+          {"calendarId", "work"},
+          {"start", start},
+          {"end", end},
+          {"allDay", allDay}};
+}
+
+QByteArray snapshot(const QJsonArray &events) {
+  return QJsonDocument(
+             QJsonObject{{"events", events},
+                         {"calendars",
+                          QJsonArray{QJsonObject{{"id", "work"}, {"name", "Work"}, {"color", "#3584e4"}}}}})
+      .toJson();
+}
+} // namespace
+
+TEST_CASE("calendar home shows real upcoming events with source metadata") {
+  const auto events = upcomingCalendarEvents(snapshot({event("soon", NOW + 600000, NOW + 1200000)}), NOW);
+  REQUIRE(events.size() == 1);
+  REQUIRE(events.front().id == "soon");
+  REQUIRE(events.front().title == "Event soon");
+  REQUIRE(events.front().calendar == "Work");
+  REQUIRE(events.front().color == "#3584e4");
+}
+
+TEST_CASE("calendar home omits ended, all-day and distant events") {
+  const auto events = upcomingCalendarEvents(
+      snapshot({event("ended", NOW - 600000, NOW), event("all-day", NOW, NOW + 86400000, true),
+                event("distant", NOW + 86400001, NOW + 90000000)}),
+      NOW);
+  REQUIRE(events.empty());
+}
+
+TEST_CASE("calendar home keeps ongoing events and limits results to the earliest three") {
+  const auto events = upcomingCalendarEvents(
+      snapshot({event("third", NOW + 300000, NOW + 900000), event("fourth", NOW + 400000, NOW + 900000),
+                event("second", NOW + 100000, NOW + 900000), event("ongoing", NOW - 100000, NOW + 100000)}),
+      NOW);
+  REQUIRE(events.size() == 3);
+  REQUIRE(events[0].id == "ongoing");
+  REQUIRE(events[1].id == "second");
+  REQUIRE(events[2].id == "third");
+}
+
+TEST_CASE("calendar home rejects malformed calendar data") {
+  REQUIRE(upcomingCalendarEvents("invalid", NOW).empty());
+  REQUIRE(upcomingCalendarEvents("{}", NOW).empty());
+  auto invalid = event("bad", NOW, NOW + 1000);
+  invalid["start"] = "tomorrow";
+  REQUIRE(upcomingCalendarEvents(snapshot({invalid}), NOW).empty());
+  REQUIRE(upcomingCalendarEvents(snapshot({event("negative", -1, NOW + 1000)}), NOW).empty());
+  REQUIRE(upcomingCalendarEvents(snapshot({event("backwards", NOW + 1000, NOW)}), NOW).empty());
+}
