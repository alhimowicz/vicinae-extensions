diff --git a/src/server/src/builtins/root/calendar-events.cpp b/src/server/src/builtins/root/calendar-events.cpp
new file mode 100644
index 0000000..4011785
--- /dev/null
+++ b/src/server/src/builtins/root/calendar-events.cpp
@@ -0,0 +1,51 @@
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <algorithm>
+#include <cmath>
+
+#include "builtins/root/calendar-events.hpp"
+
+std::vector<CalendarHomeEvent> upcomingCalendarEvents(const QByteArray &data, qint64 now) {
+  constexpr qint64 LOOK_AHEAD_MS = 24 * 60 * 60 * 1000;
+  constexpr std::size_t MAX_EVENTS = 3;
+  const auto document = QJsonDocument::fromJson(data);
+  if (!document.isObject()) return {};
+  const auto snapshot = document.object();
+  if (!snapshot.value("events").isArray() || !snapshot.value("calendars").isArray()) return {};
+
+  std::vector<CalendarHomeEvent> events;
+  const auto items = snapshot.value("events").toArray();
+  events.reserve(std::min(static_cast<std::size_t>(items.size()), MAX_EVENTS));
+  for (const auto &item : items) {
+    const auto event = item.toObject();
+    const auto start = event.value("start");
+    const auto end = event.value("end");
+    if (!event.value("id").isString() || !event.value("title").isString() ||
+        !event.value("calendarId").isString() || !event.value("allDay").isBool() ||
+        event.value("allDay").toBool() || !start.isDouble() || !end.isDouble())
+      continue;
+    const double startMs = start.toDouble();
+    const double endMs = end.toDouble();
+    if (!std::isfinite(startMs) || !std::isfinite(endMs) || startMs < 0 || startMs > endMs ||
+        endMs > 8.64e15 || endMs <= now || startMs > now + LOOK_AHEAD_MS)
+      continue;
+    QString calendarName;
+    QString color;
+    for (const auto &value : snapshot.value("calendars").toArray()) {
+      const auto calendar = value.toObject();
+      if (calendar.value("id") == event.value("calendarId")) {
+        calendarName = calendar.value("name").toString();
+        color = calendar.value("color").toString();
+        break;
+      }
+    }
+    if (event.value("id").toString().isEmpty() || event.value("title").toString().isEmpty()) continue;
+    events.emplace_back(event.value("id").toString(), event.value("title").toString(),
+                        std::move(calendarName), std::move(color), static_cast<qint64>(startMs),
+                        static_cast<qint64>(endMs));
+  }
+  std::ranges::stable_sort(events, {}, &CalendarHomeEvent::start);
+  if (events.size() > MAX_EVENTS) events.resize(MAX_EVENTS);
+  return events;
+}
