{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "chrome-profiles",
  "title": "Chrome Profiles",
  "description": "Switch between Chrome profiles, open new tabs, and browse bookmarks",
  "categories": ["Applications", "Productivity"],
  "license": "MIT",
  "author": "alhimowicz",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "chrome-profiles",
      "title": "Chrome Profiles",
      "subtitle": "Chrome",
      "description": "List and manage Chrome profiles",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "chromeVariant",
      "type": "dropdown",
      "title": "Chrome Variant",
      "description": "Which Chrome installation to use",
      "default": "auto",
      "data": [
        { "title": "Auto-detect", "value": "auto" },
        { "title": "Flatpak", "value": "flatpak" },
        { "title": "Native", "value": "native" }
      ],
      "required": false
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop"
  },
  "dependencies": {
    "@vicinae/api": "^0.20.8"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
